[Unit]
Description=claude-proxy (Anthropic Messages <-> OpenAI-compatible proxy for Claude Code)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=claude-proxy
Group=claude-proxy
WorkingDirectory=/opt/claude-proxy
EnvironmentFile=/opt/claude-proxy/.env
ExecStart=/opt/claude-proxy/.venv/bin/uvicorn main:app --host ${PROXY_HOST} --port ${PROXY_PORT}
Restart=always
RestartSec=3

# Basic hardening -- this process holds API keys, has no auth in front of it,
# and can run shell commands for the model in agent mode, so keep its blast
# radius small.
#
# Note these two lines also bound what agent mode can reach: ProtectHome
# hides /home entirely, and ProtectSystem=strict makes everything outside
# ReadWritePaths read-only. If you add a working directory in the web UI and
# the agent can't write to it, list it here too (space-separated) and set
# ProtectHome=false if it lives under /home -- then daemon-reload + restart.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/claude-proxy

[Install]
WantedBy=multi-user.target
