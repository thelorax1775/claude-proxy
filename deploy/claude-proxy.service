[Unit]
Description=claude-proxy (Anthropic Messages <-> OpenAI-compatible proxy for Claude Code)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=claude-proxy
Group=claude-proxy
WorkingDirectory=/opt/claude-proxy
EnvironmentFile=/opt/claude-proxy/.env
ExecStart=/opt/claude-proxy/.venv/bin/uvicorn main:app --host ${PROXY_HOST} --port ${PROXY_PORT}
Restart=always
RestartSec=3

# The filesystem protections that used to be here (ProtectSystem=strict,
# ProtectHome=true, ReadWritePaths=) are deliberately gone. They made every
# tool group that touches something outside /opt/claude-proxy a special case:
# a working directory added in the web UI needed a matching ReadWritePaths
# entry and a daemon-reload before the agent could write to it, and the SSH
# group needed its own key location and an AGENT_SSH_KNOWN_HOSTS override
# because ~/.ssh was hidden. Every group is now an ordinary toggle, and the
# process has the reach of the claude-proxy user -- no more, but no less.
#
# What that means: agent mode can read and write anything that user can, and
# the SSH tools reach whatever its keys open. The account, and the machine
# this runs on, are the boundary. Run it somewhere you're happy with that --
# a container or a VM, not a workstation with your own files on it.
#
# NoNewPrivileges and PrivateTmp stay: neither restricts what the tools can
# do, they only stop a setuid binary escalating out of the service and keep
# /tmp from being shared with the rest of the system.
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
