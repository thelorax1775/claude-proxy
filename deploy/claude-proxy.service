[Unit]
Description=claude-proxy (Anthropic Messages <-> OpenAI-compatible proxy for Claude Code)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=claude-proxy
Group=claude-proxy
WorkingDirectory=/opt/claude-proxy
EnvironmentFile=/opt/claude-proxy/.env
ExecStart=/opt/claude-proxy/.venv/bin/uvicorn main:app --host ${PROXY_HOST} --port ${PROXY_PORT}
Restart=always
RestartSec=3

# Basic hardening -- this process holds API keys, has no auth in front of it,
# and can run shell commands for the model in agent mode, so keep its blast
# radius small.
#
# Note these two lines also bound what agent mode can reach: ProtectHome
# hides /home entirely, and ProtectSystem=strict makes everything outside
# ReadWritePaths read-only. If you add a working directory in the web UI and
# the agent can't write to it, list it here too (space-separated) and set
# ProtectHome=false if it lives under /home -- then daemon-reload + restart.
#
# ProtectHome=true also hides the service user's own home, so ~/.ssh is
# unreachable and every SSH tool fails with "Permission denied (publickey)".
# Rather than switching it off, keep both the key and known_hosts inside the
# unit's own tree --
#   install -d -m 700 -o claude-proxy -g claude-proxy /opt/claude-proxy/.ssh
#   ssh-keygen -t ed25519 -f /opt/claude-proxy/.ssh/id_ed25519 -N ''
#   chown claude-proxy:claude-proxy /opt/claude-proxy/.ssh/id_ed25519*
# -- give that absolute path as the host's "Key file" in the Agent tab, and
# set this in .env so ssh has somewhere it may record host keys:
#   AGENT_SSH_KNOWN_HOSTS=/opt/claude-proxy/.ssh/known_hosts
# Without that last line ssh cannot write known_hosts and every connection
# fails on the host-key check.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/claude-proxy

[Install]
WantedBy=multi-user.target
