# Backend list (hosted free-tier accounts + local Ollama fallback) lives in
# backends.json, not here -- copy backends.example.json to backends.json and
# fill in your real keys, or just add them from the web UI. That file is
# gitignored.
#
# BACKENDS_CONFIG=backends.json   (default path, override if you rename it)

# What interface/port the proxy listens on (used by start.sh / start.ps1 /
# the systemd unit). Defaults to 127.0.0.1:8082 -- localhost only.
#
# There is no auth in front of this proxy: anything that can reach the port
# can use your API keys, and can switch on agent mode and get a shell on this
# machine through the web UI. Keep PROXY_HOST on 127.0.0.1, or on a private
# interface (e.g. a Tailscale IP) that only you can reach -- never a public
# one.
PROXY_HOST=127.0.0.1
PROXY_PORT=8082

# Where the default agent workspace lives, relative to the proxy's working
# directory (or an absolute path). Created automatically if missing. Extra
# working directories are added from the web UI and stored in workdirs.json.
AGENT_WORKSPACE=workspace

# Where github_clone puts repositories. Defaults to workspace/repos.
# AGENT_CLONE_ROOT=workspace/repos

# Agent tool limits. AGENT_MAX_ITERATIONS is the default tool-call budget for
# one message; the UI can change it per browser up to AGENT_ROUND_CEILING.
# Running out doesn't end the chat -- the model reports where it got to and
# you can continue. AGENT_MAX_CALLS_PER_ROUND caps how many tools one round
# may ask for, so a confused answer can't spend the whole budget at once.
# AGENT_MAX_ITERATIONS=100
# AGENT_ROUND_CEILING=500
# AGENT_MAX_CALLS_PER_ROUND=25
# AGENT_OUTPUT_LIMIT=8000

# How long a bash command gets. AGENT_TOOL_TIMEOUT is the default; a single
# call can ask for more (say, a test suite) up to AGENT_BASH_MAX_TIMEOUT.
# AGENT_TOOL_TIMEOUT=30
# AGENT_BASH_MAX_TIMEOUT=300

# SSH tools. An ordinary tool group: tick it in the Agent tab like any other,
# with nothing to configure first. Hosts live in ssh_hosts.json (gitignored,
# chmod 600) and are added from that same tab -- the tools take a registered
# NAME, never a connection string, so that file is the list of machines
# reachable from here. With the group on and the list empty the tools simply
# have nowhere to go and say so. Auth is key-based, using the service user's
# ~/.ssh unless a host names its own key file; no password is stored or
# accepted.
#
# The default timeout is higher than a bash command's because a remote build
# or package update routinely needs it; a call can ask for up to the max.
# SSH_HOSTS_CONFIG=ssh_hosts.json
# AGENT_SSH_TIMEOUT=120
# AGENT_SSH_MAX_TIMEOUT=600
#
# Host-key policy. accept-new records the key on first contact and refuses a
# CHANGED one afterwards. Set to "yes" if you pre-populate known_hosts and
# want first contact to fail instead. Don't set "no" -- that accepts a
# substituted key silently, which is to say it accepts a machine-in-the-middle.
# AGENT_SSH_STRICT_HOST_KEY=accept-new
#
# Where ssh records accepted host keys. Defaults to ~/.ssh/known_hosts, and
# the directory is created if it doesn't exist -- a service account often has
# no home on disk, and ssh will not record a key it cannot write. Set this
# only to put the file somewhere else.
# AGENT_SSH_KNOWN_HOSTS=/opt/claude-proxy/.ssh/known_hosts

# How long a backend sits out after failing, before it's tried again. Without
# this a rate-limited account goes straight back to the front of the queue and
# every request re-pays the 429. The auth one is longer because a rejected key
# doesn't recover the way a quota does.
# BACKEND_COOLDOWN=60
# BACKEND_AUTH_COOLDOWN=300

# How the chain is ordered.
#
#   least-used  (default) whichever backend has the most weekly allowance left
#               is tried first, and one that is spent is tried last -- so a
#               pool of accounts drains evenly instead of one at a time, and a
#               dead free-tier key stops costing every request a 429 before the
#               chain moves on. Comparison is in ten-point bands, so the leader
#               doesn't change every refresh; inside a band, and for any
#               backend whose usage can't be read at all, the configured order
#               stands.
#
#   configured  backends.json exactly as written.
#
# Only providers with a usage API can be measured (see /api/usage); elsewhere
# nothing is known and nothing is reordered. Spent accounts are still tried if
# everything above them fails -- a rounded figure and a window that may have
# just rolled over are not proof one will refuse.
# BACKEND_ORDER=least-used

# Superseded by BACKEND_ORDER, still honoured: 0 means the configured order.
# BACKEND_DEMOTE_SPENT=1

# web_fetch refuses hosts that resolve to a private, loopback or link-local
# address (including after a redirect), so a URL the model chose can't reach
# this machine's own services or a cloud metadata endpoint.
#
# This is a ceiling, not a switch. Left at 0, nothing can reach the LAN and
# the "LAN access" toggle below the composer stays locked. Set to 1 and that
# toggle becomes usable -- still off by default, decided per message. So the
# answer to "can the model reach my network" is: only if you set this AND
# tick the box for that message.
# AGENT_WEB_ALLOW_PRIVATE=0

# GitHub API base, for GitHub Enterprise. Seeds the value in integrations.json;
# anything saved through the UI/API wins over this.
# GITHUB_API=https://api.github.com

# State files, all gitignored and all created automatically:
#   workdirs.json      -- directories agent mode may work in
#   integrations.json  -- GitHub token and web-search key (chmod 600)
#   ssh_hosts.json     -- SSH hosts agent mode may connect to (chmod 600)
#   sessions/          -- saved chats
# AGENT_DIRS_CONFIG=workdirs.json
# INTEGRATIONS_CONFIG=integrations.json
# SESSIONS_DIR=sessions
# MAX_SESSIONS=200
