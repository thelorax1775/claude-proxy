# Backend list (5 hosted free-tier accounts + local Ollama fallback) lives in
# backends.json, not here -- copy backends.example.json to backends.json and
# fill in your real keys. That file is gitignored.
#
# BACKENDS_CONFIG=backends.json   (default path, override if you rename it)

# What interface/port the proxy listens on (used by start.sh / start.ps1 /
# the systemd unit). Defaults to 127.0.0.1:8082 -- localhost only.
# If Claude Code runs on a DIFFERENT machine than the proxy (e.g. proxy
# deployed on a Linux box, Claude Code on your Windows desktop, talking over
# Tailscale), set PROXY_HOST to 0.0.0.0 or the box's Tailscale IP so it's
# reachable -- and set PROXY_SHARED_KEY below when you do, since anything
# beyond 127.0.0.1 has no auth otherwise.
PROXY_HOST=127.0.0.1
PROXY_PORT=8082

# Optional: require Claude Code to send this exact key to the local proxy.
# Leave blank while testing on localhost; set it if you ever bind beyond 127.0.0.1.
PROXY_SHARED_KEY=
